# Strands Guardian - Environment Variables
# Copy this file to .env and fill in your API keys

# ── Strands / LLM ─────────────────────────────
# STRANDS_MODEL_ID=us.anthropic.claude-sonnet-4-20250514
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── Intel APIs (at least one of SerpApi/Tavily required) ──
SERPAPI_API_KEY=
TAVILY_API_KEY=

# ── ICS Discovery ──────────────────────────────
CENSYS_API_ID=
CENSYS_API_SECRET=

# ── Geo Feeds ──────────────────────────────────
FIRMS_MAP_KEY=

# ── Notifications ──────────────────────────────
SLACK_WEBHOOK_URL=
# GUARDIAN_WEBHOOK_URL=
